# 第三方工具链、缓存和下载物
/.tools/
*.zip
*.7z
*.rar
*.tar
*.gz
*.msi

# 构建产物
/dist/
*.exe
*.dll
*.test
*.out
*.prof
*.pprof

# 日志、临时文件和备份
*.log
*.tmp
*.bak
*.swp
*~

# 本地配置和密钥
.env
.env.*
*.local.*
*.pem
*.key

# 编辑器、IDE 和 AI 工具的本地状态
# .cursor 只跟踪 rules 和 skills；调试日志、plans 等留在本地
/.cursor/*
!/.cursor/rules/
!/.cursor/skills/
/.vscode/
/.idea/
*.code-workspace

# 系统垃圾文件
Thumbs.db
Desktop.ini
.DS_Store
